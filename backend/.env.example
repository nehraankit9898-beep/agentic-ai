# LLM Configuration
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
API_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# Tool Permissions (comma-separated list of allowed tools)
ALLOWED_TOOLS=calculator,file_reader,file_writer,directory_lister,date_time

# Sandbox settings for Python execution
PYTHON_SANDBOX=true
