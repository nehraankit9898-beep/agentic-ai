# Phase 1 – environment configuration example.
# Copy to backend/.env and adjust values.

# Environment: development | staging | production
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Configuration (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_PROVIDER=ollama

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
API_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# Workspace / agent limits
WORKSPACE_ROOT=./workspace_data
MAX_TOOL_RUNTIME=30
MAX_AGENT_STEPS=10

# Tool Permissions (comma-separated list of allowed tools)
ALLOWED_TOOLS=calculator,file_reader,file_writer,directory_lister,date_time

# Sandbox settings for Python execution
PYTHON_SANDBOX=true
